# Harness run state
.claude/logs/
.claude/reports/
.claude/settings.local.json
.claude/worktrees/

# YOUR data never lives in this repo (see data/README.md)
data/*
!data/README.md

# Secrets and local env — never tracked
.env
.env.*
*.pem
*.key

# Node
node_modules/
*.log
# ...but test fixtures may legitimately ship a .log (e.g. outbox/delivered.log)
!packages/*/tests/fixtures/**/*.log
!packages/*/evals/cases/**/*.log

# OS
.DS_Store

# eval-suite.sh run state (per-manifest last-outcomes sidecar; see
# packages/core/scripts/eval-suite.sh and packages/core/contracts/eval-case.md)
.last-run.tsv
